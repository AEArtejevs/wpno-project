+#!/usr/bin/env python3.11
+"""Konsolidiert den INDEPENDENT_L99_RECHECK (670e362): liest das Council-Journal (Gremium A+B),
+merged mit den deterministischen Recheck-Findings und erzeugt Council-Reports, Evidence Tribunal,
+Finding-Reconciliation und die L99-Entscheidung. Read-only ggue. Produkt."""
+import csv, json, os, sys
+
+REPO = '/Users/martinotten/wpno-rechtsprechung-db'
+JOURNAL = sys.argv[1] if len(sys.argv) > 1 else ''
+R = os.path.join(REPO, 'reports')
+
+def load_council(path):
+    a, b = [], []
+    if not path or not os.path.exists(path):
+        return a, b
+    for line in open(path):
+        try:
+            o = json.loads(line)
+        except Exception:
+            continue
+        if o.get('type') != 'result':
+            continue
+        res = o.get('result')
+        if isinstance(res, str):
+            try:
+                res = json.loads(res)
+            except Exception:
+                continue
+        if not isinstance(res, dict):
+            continue
+        if isinstance(res.get('councilA'), list):
+            a.extend(res['councilA'])
+        if isinstance(res.get('councilB'), list):
+            b.extend(res['councilB'])
+        # Einzelagenten-Rueckgaben (falls Workflow einzeln journalt)
+        if 'findings' in res and 'role_id' in res:
+            a.append(res)
+        if 'attacks' in res and 'role_id' in res:
+            b.append(res)
+    # dedupe per role_id (letzter gewinnt)
+    da = {r.get('role_id'): r for r in a if isinstance(r, dict)}
+    db = {r.get('role_id'): r for r in b if isinstance(r, dict)}
+    return list(da.values()), list(db.values())
+
+A, B = load_council(JOURNAL)
+
+# ---- Council A report ----
+with open(os.path.join(R, 'S11_PS861_006D_RECHECK_ASSURANCE_COUNCIL_A.csv'), 'w', newline='') as f:
+    w = csv.writer(f)
+    w.writerow(['role_id', 'claim_tested', 'verified', 'evidence', 'counterexample', 'remaining_gap', 'severity', 'l99_effect'])
+    for r in sorted(A, key=lambda x: x.get('role_id', '')):
+        for fd in r.get('findings', []):
+            w.writerow([r.get('role_id', ''), fd.get('claim_tested', ''), fd.get('verified', ''),
+                        (fd.get('evidence', '') or '')[:300], (fd.get('counterexample', '') or '')[:200],
+                        (fd.get('remaining_gap', '') or '')[:200], fd.get('severity', ''), fd.get('l99_effect', '')])
+
+# ---- Council B report ----
+b_bypass = []
+with open(os.path.join(R, 'S11_PS861_006D_RECHECK_BREAKER_COUNCIL_B.csv'), 'w', newline='') as f:
+    w = csv.writer(f)
+    w.writerow(['role_id', 'attack_class', 'independent_oracle', 'expected', 'actual', 'bypass_successful', 'severity', 'affected_component', 'l99_effect'])
+    for r in sorted(B, key=lambda x: x.get('role_id', '')):
+        for at in r.get('attacks', []):
+            w.writerow([r.get('role_id', ''), at.get('attack_class', ''), (at.get('independent_oracle', '') or '')[:160],
+                        (at.get('expected', '') or '')[:120], (at.get('actual', '') or '')[:160],
+                        at.get('bypass_successful', ''), at.get('severity', ''), at.get('affected_component', ''), at.get('l99_effect', '')])
+            if at.get('bypass_successful') == 'ja':
+                b_bypass.append((r.get('role_id', ''), at.get('attack_class', ''), at.get('severity', ''), at.get('affected_component', '')))
+
+# ---- Council-Severity aggregieren ----
+def council_block(items, key):
+    out = []
+    for r in items:
+        for fd in r.get(key, []):
+            sev = fd.get('severity', 'NONE')
+            eff = fd.get('l99_effect', 'NONE')
+            byp = fd.get('bypass_successful', 'nein')
+            if eff == 'BLOCK' or sev in ('P0', 'CRITICAL') or byp == 'ja':
+                out.append((r.get('role_id'), sev, eff))
+    return out
+
+a_block = council_block(A, 'findings')
+b_block = council_block(B, 'attacks')
+
+# ---- Evidence Tribunal: nur geschlossen wenn alle 5 Evidenzwerte true ----
+det = list(csv.DictReader(open(os.path.join(R, 'S11_PS861_006D_ALLOWLIST_RECHECK_DETERMINISTIC_FINDINGS.csv'))))
+with open(os.path.join(R, 'S11_PS861_006D_ALLOWLIST_EVIDENCE_TRIBUNAL.csv'), 'w', newline='') as f:
+    w = csv.writer(f)
+    w.writerow(['finding_id', 'artifact_evidence_present', 'independent_test_present', 'oracle_independent', 'reproducible', 'finding_closed', 'severity'])
+    for d in det:
+        # Deterministische Recheck-Findings sind OFFENE Defekte (nicht geschlossen) -> finding_closed=false
+        w.writerow([d['finding_id'], 'true', 'true', 'true', d['reproduziert'].startswith('ja'), 'false', d['severity']])
+
+open(os.path.join(R, 'S11_PS861_006D_ALLOWLIST_EVIDENCE_TRIBUNAL.md'), 'w').write(
+    '# S11-PS861-006D Allowlist — Evidence Tribunal\n\nNicht-generatives Schiedsgericht. Ein Finding gilt nur '
+    'als GESCHLOSSEN, wenn artifact_evidence_present ∧ independent_test_present ∧ oracle_independent ∧ '
+    'reproducible ∧ finding_closed alle true sind. Keine Mehrheitsentscheidung. Ein einzelnes reproduziertes '
+    f'P0/CRITICAL blockiert L99.\n\nDeterministische Recheck-Findings: {len(det)} — davon '
+    f'{sum(1 for d in det if d["severity"] in ("P0","CRITICAL"))} P0/CRITICAL, alle reproduziert und OFFEN '
+    '(finding_closed=false). Gremium A Block-Votum: '
+    f'{len(a_block)}; Gremium B erfolgreiche Bypaesse: {len(b_bypass)}. '
+    'Ergebnis: mindestens ein reproduziertes P0 (staged-blob) offen -> L99 BLOCKIERT.\n')
+
+# ---- Konsolidierte L99-Entscheidung ----
+p0 = [d for d in det if d['severity'] == 'P0']
+axes = {
+ 'schema_correctness': 'BLOCKED (RCK2-07: empirisch abgeleitet, kein Berufstraeger-Sign-off; RCK2-04 Whitespace)',
+ 'meta_field_security': 'BLOCKED (RCK2-03: Regex akzeptiert Monat 13)',
+ 'path_security': 'OPEN (Symlink/nested-.git ok; Hardlink/LFS/Submodule via Gremium B)',
+ 'staged_blob_security': 'BLOCKED (RCK2-01: P0 reproduziert)',
+ 'toctou_security': 'BLOCKED (RCK2-02: P0 reproduziert)',
+ 'format_security': 'BLOCKED (RCK2-05: ftyp-Pfad ungetestet, Mutation ueberlebt)',
+ 'decision_class_integrity': 'OPEN (Gremium B9/A5)',
