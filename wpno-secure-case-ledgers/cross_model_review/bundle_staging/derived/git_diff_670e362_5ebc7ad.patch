+#!/usr/bin/env python3.11
+"""QC-Beleg (INDEPENDENT_L99_RECHECK 670e362): staged-blob-/TOCTOU-Luecke.
+
+Reproduziert, dass der Pre-Commit-Gate die 006D-Guards gegen den WORKING TREE (B.repdir())
+laufen laesst, waehrend git den INDEX/STAGED BLOB committet. Ein Angreifer st 'add't eine boese
+Version, macht die Working-Tree-Datei danach wieder sauber -> Gate PASS, committet wird die boese.
+
+Read-only ggue. dem Produkt: erzeugt ein WEGWERF-Repo im Scratchpad. Exit 0 = Luecke reproduziert."""
+import os, subprocess, sys, tempfile
+
+def sh(cmd, cwd):
+    return subprocess.run(cmd, cwd=cwd, shell=True, capture_output=True, text=True)
+
+def main():
+    d = tempfile.mkdtemp(prefix='stagedblob_')
+    os.makedirs(os.path.join(d, 'reports'))
+    # guard-Ersatz mit identischer Semantik wie check_006d_* (liest Working-Tree-Datei)
+    guard = ("import sys\n"
+             "bad=b'BADVALUE' in open('reports/artifact.csv','rb').read()\n"
+             "print('FAIL' if bad else 'ok'); sys.exit(1 if bad else 0)\n")
+    open(os.path.join(d, 'guard.py'), 'w').write(guard)
+    for c in ("git init -q", "git config user.email t@t", "git config user.name t"):
+        sh(c, d)
+    open(os.path.join(d, 'reports/artifact.csv'), 'w').write('id,field\nA1,CLEAN\n')
+    sh("git add -A && git commit -qm base", d)
+    # Angriff: boesen Blob stagen, dann Working-Tree wieder saeubern
+    open(os.path.join(d, 'reports/artifact.csv'), 'w').write('id,field\nA1,BADVALUE\n')
+    sh("git add reports/artifact.csv", d)
+    open(os.path.join(d, 'reports/artifact.csv'), 'w').write('id,field\nA1,CLEAN\n')
+    g = sh("python3.11 guard.py", d)
+    sh("git commit -qm attack", d)
+    committed = sh("git show HEAD:reports/artifact.csv", d).stdout
+    gate_saw_clean = (g.returncode == 0)
+    committed_bad = 'BADVALUE' in committed
+    reproduced = gate_saw_clean and committed_bad
+    print(f"gate_exit={g.returncode} (0=sah_sauber) | committed_enthaelt_BADVALUE={committed_bad}")
+    print(f"STAGED_BLOB_GAP_REPRODUCED={reproduced}")
+    sys.exit(0 if reproduced else 1)
+
+if __name__ == '__main__':
+    main()
