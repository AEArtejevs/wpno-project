+#!/usr/bin/env python3.11
+"""QC-Beleg (INDEPENDENT_L99_RECHECK 670e362): Property-based + metamorphe Tests mit UNABHAENGIGEM Oracle.
+
+Der Produkt-Validator ist SYSTEM-UNDER-TEST; die erwartete Wahrheit ist hier HARTKODIERT (nicht aus
+dem Produkt berechnet) -> keine Oracle-Zirkularitaet. Generiert Eingaben algorithmisch (nicht nur feste
+Beispiele) und prueft Invarianten. Read-only ggue. Produkt (importiert Validator nur lesend als SUT).
+
+Ergebnis je Property: PASS = Produkt erfuellt Invariante; FAIL = Gegenbeispiel (Finding)."""
+import os, sys, importlib.util
+
+REPO = '/Users/martinotten/wpno-rechtsprechung-db'
+sys.path.insert(0, os.path.join(REPO, 'zitate_register'))
+spec = importlib.util.spec_from_file_location('_vs', os.path.join(REPO, 'zitate_register', '_s11_006d_spec_validator.py'))
+VS = importlib.util.module_from_spec(spec); spec.loader.exec_module(VS)
+
+results = []
+def record(pid, name, ok, detail=''):
+    results.append((pid, name, 'PASS' if ok else 'FAIL', detail))
+
+# Ein Artefakt mit ID-Feld + Frozen-Feld aus dem Schema greifen
+art = next((a for a, fs in VS.SCHEMA.items()
+            if any(f['cls'] == 'ID' for f in fs.values()) and any(f['cls'] == 'FROZEN_SET' for f in fs.values())), None)
+fields = VS.SCHEMA.get(art, {})
+id_col = next((c for c, f in fields.items() if f['cls'] == 'ID'), None)
+frozen_col = next((c for c, f in fields.items() if f['cls'] == 'FROZEN_SET' and f.get('allowed')), None)
+good_id = fields[id_col].get('example') or (VS.re.sub(r'.', 'A', 'PLACEHOLDER'))
+frozen_ok = sorted(fields[frozen_col]['allowed'])[0] if frozen_col else None
+
+def cell_rejected(col, val):
+    """unabhaengig: ruft die Produkt-Zellpruefung, True wenn ABGEWIESEN."""
+    try:
+        return bool(VS.validate_cell(art, col, val))
+    except Exception:
+        return True  # Ausnahme = fail-closed gewertet
+
+# P1: jeder generierte UNBEKANNTE Frozen-Wert wird abgewiesen (algorithmisch generiert)
+if frozen_col:
+    gen = [frozen_ok + 'X', frozen_ok.upper() + '_', frozen_ok + ' ', '​' + frozen_ok,
+           frozen_ok.replace(frozen_ok[:1], frozen_ok[:1] + '́', 1), 'NEU_' + str(hash(frozen_col) % 97)]
+    bad = [g for g in gen if g not in fields[frozen_col]['allowed'] and not cell_rejected(frozen_col, g)]
+    record('P1', 'unbekannter Frozen-Wert -> FAIL', not bad, f'nicht abgewiesen: {bad[:3]}')
+
+# P2: jede UNBEKANNTE Spalte wird abgewiesen
+unknown_cols = ['zzz_new', frozen_col + '​' if frozen_col else 'x', (frozen_col or 'x').upper() + '_2']
+missc = [c for c in unknown_cols if c not in fields and not cell_rejected(c, 'irgendwas')]
+record('P2', 'unbekannte Spalte -> FAIL', not missc, f'nicht abgewiesen: {missc}')
+
+# P3: Meta-Feld — generierte ungueltige ISO-Zeitpunkte scheitern
+meta_art = next((a for a, fs in VS.SCHEMA.items() if any(f['cls'] == 'META' for f in fs.values())), None)
+if meta_art:
+    mcol = next((c for c, f in VS.SCHEMA[meta_art].items()
+                 if f['cls'] == 'META' and 'created_at' in c.lower()), None)
+    if mcol:
+        invalid_iso = ['2026-13-01T00:00:00Z', '2026-07-12 00:00:00', '2026-07-12T00:00:00',
+                       'gestern', '2026-07-12T00:00:00Z; DROP', '']
+        leaked = [x for x in invalid_iso if not VS.validate_cell(meta_art, mcol, x)]
+        record('P3', 'ungueltiger ISO-Zeitpunkt (Meta) -> FAIL', not leaked, f'durchgelassen: {leaked[:3]}')
+    else:
+        record('P3', 'created_at Meta-Feld vorhanden', False, 'kein created_at-Feld gefunden')
+
+# P4: nicht-manifestierter Ausgabepfad -> Manifest-Guard faengt (Struktur-Check statt Zelle)
+manifest = os.path.join(REPO, 'memory', 'S11_PS861_006D_ALLOWED_OUTPUT_MANIFEST.csv')
+record('P4', 'Ausgabe-Manifest existiert (Positivliste)', os.path.exists(manifest),
+       'Manifest fehlt' if not os.path.exists(manifest) else '')
+
+# P5: Binaerdatei-Magic im Modell-only wird als content_type_violation erkannt (unabh. Bytes)
+import tempfile
+pdf = tempfile.NamedTemporaryFile(suffix='.csv', delete=False); pdf.write(b'%PDF-1.4\n%x'); pdf.close()
+record('P5', 'PDF-Magic in .csv -> content_type_violation', bool(VS.content_type_violation(pdf.name)),
+       'nicht erkannt' if not VS.content_type_violation(pdf.name) else '')
+
+# --- Metamorphe Relationen ---
+# M1: Frozen-Wert mit fuehrendem/anhaengendem Whitespace darf NICHT ploetzlich gueltig werden
+if frozen_col:
+    ws_ok = cell_rejected(frozen_col, ' ' + frozen_ok) and cell_rejected(frozen_col, frozen_ok + '\t')
+    record('M1', 'Whitespace-Variante aendert Status nicht (fail-closed)', ws_ok,
+           'Whitespace-Variante akzeptiert' if not ws_ok else '')
+# M2: Unicode-NFKC-Homoglyph eines Frozen-Werts wird abgewiesen
+if frozen_col and frozen_ok:
+    homo = frozen_ok.replace('a', 'а').replace('e', 'е').replace('o', 'о')
+    record('M2', 'Kyrillischer Homoglyph -> FAIL', homo == frozen_ok or cell_rejected(frozen_col, homo),
+           'Homoglyph akzeptiert' if homo != frozen_ok and not cell_rejected(frozen_col, homo) else '')
+# M3: Dateiname aendern darf Binaer-Erkennung nicht beeinflussen (neutral benannt bleibt binaer)
+neutral = tempfile.NamedTemporaryFile(suffix='.md', delete=False); neutral.write(b'PK\x03\x04zip'); neutral.close()
+record('M3', 'Dateiname .md schuetzt ZIP nicht', bool(VS.content_type_violation(neutral.name)),
+       'ZIP unter .md nicht erkannt' if not VS.content_type_violation(neutral.name) else '')
+
+fails = [r for r in results if r[2] == 'FAIL']
+print(f"PROPERTY/METAMORPH (unabhaengiges Oracle): {len(results)-len(fails)}/{len(results)} PASS")
+for r in results:
+    print(f"  {r[0]} {r[2]}: {r[1]}" + (f' | {r[3]}' if r[3] else ''))
+print(f"FAILS={len(fails)}")
+sys.exit(0)
