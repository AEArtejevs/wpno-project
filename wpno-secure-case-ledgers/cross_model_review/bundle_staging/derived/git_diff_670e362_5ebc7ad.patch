+#!/usr/bin/env python3.11
+"""QC-Beleg (INDEPENDENT_L99_RECHECK 670e362): Mutation-Score des Positiv-Validators.
+
+Kopiert zitate_register + tests in eine Sandbox, mutiert _s11_006d_spec_validator.py semantisch und
+misst, ob die BESTEHENDE Hardening-Suite die Mutation toetet. Ueberlebende (Suite bleibt gruen) =
+Testluecke. Belegt zugleich die Oracle-Abhaengigkeit: die Tests importieren den Produkt-Validator
+(18 Aufrufstellen), daher sind subtile Mutationen teilweise unsichtbar.
+
+Read-only ggue. dem Produkt (arbeitet nur auf der Sandbox-Kopie)."""
+import os, re, shutil, subprocess, sys, tempfile
+
+REPO = '/Users/martinotten/wpno-rechtsprechung-db'
+MUTANTS = [
+    ('M1_validate_cell_always_none', r'def validate_cell\(([^)]*)\):', r'def validate_cell(\1):\n    return None  #MUT'),
+    ('M2_content_type_always_none', r'def content_type_violation\(([^)]*)\):', r'def content_type_violation(\1):\n    return None  #MUT'),
+    ('M3_path_symlink_always_none', r'def path_symlink_violation\(([^)]*)\):', r'def path_symlink_violation(\1):\n    return None  #MUT'),
+    ('S1_no_lstrip_before_magic', re.escape("raw.lstrip(b' \\t\\r\\n\\xef\\xbb\\xbf')"), 'raw'),
+    ('S2_drop_svgz_ext', re.escape("'.svgz',"), ''),
+    ('S4_drop_ftyp_magic', re.escape("head[4:8] == b'ftyp'"), "False and head[4:8] == b'ftyp'"),
+    ('S5_disable_data_url', re.escape('data:[a-z]'), 'XXXX:[a-z]'),
+]
+
+def run_suite(sbx):
+    r = subprocess.run(
+        ['python3.11', 'test_s11_ps861_006d_allowlist_hardening.py'],
+        cwd=os.path.join(sbx, 'tests'),
+        env={**os.environ, 'PYTHONPATH': f"{sbx}/zitate_register:{sbx}/tests"},
+        capture_output=True, text=True)
+    m = re.search(r'(\d+)/(\d+) PASS', r.stdout)
+    return (int(m.group(1)), int(m.group(2))) if m else (0, 0)
+
+def main():
+    sbx = tempfile.mkdtemp(prefix='mutscore_')
+    for sub in ('zitate_register', 'tests', 'reports'):
+        shutil.copytree(os.path.join(REPO, sub), os.path.join(sbx, sub))
+    vpath = os.path.join(sbx, 'zitate_register', '_s11_006d_spec_validator.py')
+    src = open(os.path.join(REPO, 'zitate_register', '_s11_006d_spec_validator.py')).read()
+    base_pass, base_tot = run_suite(sbx)
+    killed = survived = na = 0
+    rows = []
+    for name, pat, rep in MUTANTS:
+        mutated, n = re.subn(pat, rep, src, count=1)
+        if n == 0:
+            na += 1; rows.append((name, 'N/A', 'Muster fehlt')); continue
+        open(vpath, 'w').write(mutated)
+        p, t = run_suite(sbx)
+        open(vpath, 'w').write(src)  # zuruecksetzen
+        if p < base_pass:
+            killed += 1; rows.append((name, 'KILLED', f'{p}/{t}'))
+        else:
+            survived += 1; rows.append((name, 'SURVIVED', f'{p}/{t}'))
+    scored = killed + survived
+    print(f"baseline={base_pass}/{base_tot}")
+    for r in rows:
+        print(f"  {r[0]}: {r[1]} ({r[2]})")
+    print(f"mutation_score={killed}/{scored} ({0 if not scored else round(100*killed/scored)}%) | survived={survived} | na={na}")
+    # kritischer ueberlebender Mutant (Detektionspfad ohne Test) blockiert L99
+    crit = [r[0] for r in rows if r[1] == 'SURVIVED' and r[0].startswith(('S4', 'M'))]
+    print(f"critical_survived_mutants={crit}")
+    sys.exit(0)
+
+if __name__ == '__main__':
+    main()
