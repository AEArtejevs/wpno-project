              }
            },
            "required": [
              "query",
              "akte_id"
            ],
            "type": "object"
          },
          "requires_anon": false
        },
        "ki_visual_rag": {
          "input_schema": {
            "properties": {
              "akte_id": {
                "type": "string"
              },
              "query": {
                "type": "string"
              }
            },
            "required": [
              "query",
              "akte_id"
            ],
            "type": "object"
          },
          "requires_anon": false
        },
        "search_bfh": {
          "input_schema": {
            "properties": {
