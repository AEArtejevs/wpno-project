{
  "servers": {
    "db-mcp": {
      "cmd": "wpno-db-mcp --readonly-user",
      "egress": "local",
      "scopes": [
        "stufe1_lokal",
        "recherche_extern",
        "all"
      ],
      "tools": {
        "query_sql": {
          "input_schema": {
            "properties": {
              "akte_id": {
                "type": "string"
              },
              "sql": {
                "type": "string"
              }
            },
            "required": [
              "sql"
            ],
            "type": "object"
          },
          "requires_anon": false
        }
      },
      "transport": "stdio"
    },
    "filesystem-mcp": {
      "cmd": "npx -y @modelcontextprotocol/server-filesystem '/Users/martinotten/WPNO/test_akte'",
      "egress": "local",
      "scopes": [
        "stufe1_lokal",
        "recherche_extern",
        "all"
      ],
      "tools": {
        "list_dir": {
          "input_schema": {
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "requires_anon": false
        },
        "read_file": {
          "input_schema": {
            "properties": {
              "path": {
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "requires_anon": false
        },
        "write_output": {
          "input_schema": {
            "properties": {
              "content": {
                "type": "string"
              },
              "path": {
                "description": "nur unterhalb 06_Ausgabe_final erlaubt (K6)",
                "type": "string"
              }
            },
            "required": [
              "path",
              "content"
            ],
            "type": "object"
          },
          "requires_anon": false
        }
      },
      "transport": "stdio"
    },
    "libra-mcp": {
      "cmd": "/opt/homebrew/bin/python3.11 '/Users/martinotten/Library/Application Support/Claude/mcp/libra/server.py'",
      "egress": "local",
      "scopes": [
        "stufe1_lokal",
        "recherche_extern",
        "all"
      ],
      "tools": {
        "archiv_search": {
          "input_schema": {
            "properties": {
              "query": {
                "type": "string"
