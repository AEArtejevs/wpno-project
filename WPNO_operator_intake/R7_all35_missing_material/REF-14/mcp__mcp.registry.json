              },
              "query": {
                "type": "string"
              }
            },
            "required": [
              "query",
              "jahr_von",
              "jahr_bis"
            ],
            "type": "object"
          },
          "requires_anon": false
        },
        "search_courts": {
          "input_schema": {
            "properties": {
              "query": {
                "type": "string"
              }
            },
            "required": [
              "query"
            ],
            "type": "object"
          },
          "requires_anon": false
        },
        "search_legislation": {
          "input_schema": {
            "properties": {
              "query": {
                "type": "string"
              }
            },
            "required": [
              "query"
            ],
            "type": "object"
          },
          "requires_anon": false
        }
      },
      "transport": "stdio"
    },
    "playwright-mcp": {
      "egress": "extern",
      "scopes": [
        "recherche_extern",
        "all"
      ],
      "tools": {
        "fetch_page": {
          "input_schema": {
            "properties": {
              "url": {
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "type": "object"
          },
          "requires_anon": true
        }
      },
      "transport": "http",
      "url": "http://playwright-mcp:3100"
    },
    "python-sandbox-mcp": {
      "cmd": "wpno-python-sandbox --no-network --timeout 60",
      "egress": "local",
      "scopes": [
        "stufe1_lokal",
        "recherche_extern",
        "all"
      ],
      "tools": {
        "run_python": {
          "input_schema": {
            "properties": {
              "code": {
                "type": "string"
              },
              "timeout_s": {
                "default": 60,
                "type": "integer"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          },
          "requires_anon": false
        }
      },
      "transport": "stdio"
    }
