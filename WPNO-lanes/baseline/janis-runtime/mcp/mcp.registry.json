    "python-sandbox-mcp": {
      "transport": "stdio",
      "cmd": "wpno-python-sandbox --no-network --timeout 60",
      "egress": "local",
      "scopes": ["stufe1_lokal", "recherche_extern", "all"],
      "tools": {
        "run_python": {
          "requires_anon": false,
          "input_schema": {
