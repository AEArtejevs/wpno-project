              "top_k": { "type": "integer", "default": 8 }
            },
            "required": ["query", "akte_id"]
          }
        },
        "search_bfh": {
          "requires_anon": false,
          "input_schema": {
            "type": "object",
            "properties": {
              "query": { "type": "string" },
              "jahr_von": { "type": "integer" },
              "jahr_bis": { "type": "integer" }
            },
            "required": ["query", "jahr_von", "jahr_bis"]
          }
        },
        "health_check": {
          "requires_anon": false,
          "input_schema": { "type": "object", "properties": {} }
        },
        "ki_graphrag_search": {
          "requires_anon": false,
          "input_schema": {
            "type": "object",
            "properties": {
              "query": { "type": "string" },
              "akte_id": { "type": "string" }
            },
            "required": ["query", "akte_id"]
          }
        },
        "ki_visual_rag": {
          "requires_anon": false,
          "input_schema": {
            "type": "object",
            "properties": {
              "query": { "type": "string" },
              "akte_id": { "type": "string" }
            },
            "required": ["query", "akte_id"]
          }
        },
        "fetch_bfh_decision": {
          "requires_anon": false,
          "input_schema": {
            "type": "object",
            "properties": { "az": { "type": "string" } },
            "required": ["az"]
          }
        },
        "archiv_search": {
          "requires_anon": false,
          "input_schema": {
            "type": "object",
            "properties": { "query": { "type": "string" } },
            "required": ["query"]
          }
        },
        "search_courts": {
          "requires_anon": false,
          "input_schema": {
            "type": "object",
            "properties": { "query": { "type": "string" } },
            "required": ["query"]
          }
        },
        "search_legislation": {
          "requires_anon": false,
          "input_schema": {
            "type": "object",
            "properties": { "query": { "type": "string" } },
            "required": ["query"]
          }
        }
      }
    },
    "filesystem-mcp": {
      "transport": "stdio",
      "cmd": "npx -y @modelcontextprotocol/server-filesystem '/Users/martinotten/WPNO/test_akte'",
      "egress": "local",
      "scopes": ["stufe1_lokal", "recherche_extern", "all"],
      "tools": {
        "read_file": {
          "requires_anon": false,
          "input_schema": {
            "type": "object",
            "properties": { "path": { "type": "string" } },
            "required": ["path"]
          }
        },
        "list_dir": {
          "requires_anon": false,
          "input_schema": {
            "type": "object",
            "properties": { "path": { "type": "string" } },
            "required": ["path"]
          }
        },
        "write_output": {
          "requires_anon": false,
          "input_schema": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "description": "nur unterhalb 06_Ausgabe_final erlaubt (K6)" },
              "content": { "type": "string" }
            },
            "required": ["path", "content"]
          }
        }
      }
