{
  "servers": {
    "libra-mcp": {
      "transport": "stdio",
      "cmd": "/opt/homebrew/bin/python3.11 '/Users/martinotten/Library/Application Support/Claude/mcp/libra/server.py'",
      "egress": "local",
      "scopes": ["stufe1_lokal", "recherche_extern", "all"],
      "tools": {
        "ki_anonymize": {
          "requires_anon": false,
          "input_schema": {
            "type": "object",
            "properties": {
              "text": { "type": "string" },
