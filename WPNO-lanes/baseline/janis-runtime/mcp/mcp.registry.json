    "db-mcp": {
      "transport": "stdio",
      "cmd": "wpno-db-mcp --readonly-user",
      "egress": "local",
      "scopes": ["stufe1_lokal", "recherche_extern", "all"],
      "tools": {
        "query_sql": {
          "requires_anon": false,
          "input_schema": {
            "type": "object",
            "properties": {
