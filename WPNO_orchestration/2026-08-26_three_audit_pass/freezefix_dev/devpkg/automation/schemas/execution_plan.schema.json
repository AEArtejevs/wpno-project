{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Level-1 execution plan produced by the Planner",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "audit_id", "run_phase", "scope", "target", "steps",
               "test_matrix"],
  "properties": {
    "schema": {"const": "wpno.level1.execution_plan/1"},
    "audit_id": {"type": "string", "pattern": "^L1-A[0-3][0-9]$"},
    "run_phase": {"enum": ["RUN-A", "RUN-B", "COMPARISON"]},
    "scope": {"type": "string", "minLength": 1},
    "static_analysis": {"type": "string"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "identity_evidence": {"type": "string"}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "operation"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "minLength": 1},
          "params": {"type": "object", "additionalProperties": true, "properties": {}},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
          "purpose": {"type": "string"},
          "control_role": {"enum": ["POSITIVE", "NEGATIVE", "MUTATION",
                                    "ORACLE", "MEASUREMENT"]}
        }
      }
    },
    "test_matrix": {"type": "array", "items": {"type": "object",
      "additionalProperties": true, "properties": {}}}
  }
}
