{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "One recorded operation",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "audit_id", "run_phase", "operation", "argv",
               "exit_code", "stdout_sha256", "stderr_sha256",
               "timeout_seconds", "output_limit_bytes", "started", "finished"],
  "properties": {
    "evidence_id": {"type": "string", "minLength": 1},
    "audit_id": {"type": "string", "pattern": "^L1-A[0-3][0-9]$"},
    "run_phase": {"enum": ["RUN-A", "RUN-B", "COMPARISON"]},
    "operation": {"type": "string", "minLength": 1},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "exit_code": {"type": ["integer", "null"]},
    "stdout_path": {"type": "string"},
    "stderr_path": {"type": "string"},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stdout_bytes": {"type": "integer", "minimum": 0},
    "stderr_bytes": {"type": "integer", "minimum": 0},
    "stdout_truncated": {"type": "boolean"},
    "stderr_truncated": {"type": "boolean"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
    "output_limit_bytes": {"type": "integer", "minimum": 1},
    "started": {"type": "number"},
    "finished": {"type": "number"},
    "note": {"type": ["string", "null"]}
  }
}
