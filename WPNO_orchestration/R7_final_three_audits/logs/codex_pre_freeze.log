@@ -0,0 +1,444 @@
+#!/usr/bin/env python3
+"""Independent, offline R7 pre-freeze verifier. Writes only beside this file."""
+from __future__ import annotations
+
+import ast
+import datetime as dt
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+HERE = Path(__file__).resolve().parent
+R7 = HERE.parent
+PROJECT = R7.parent
+ENV = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
+LOG = []
+FAIL = []
+M = {}
+
+
+def sha_bytes(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def sha(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as f:
+        for block in iter(lambda: f.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def run(argv, cwd=R7, timeout=600):
+    argv = [str(x) for x in argv]
+    p = subprocess.run(argv, cwd=str(cwd), env=ENV, shell=False,
+                       timeout=timeout, stdout=subprocess.PIPE,
+                       stderr=subprocess.PIPE)
+    LOG.append({"argv": argv, "exit_code": p.returncode,
+                "stdout_sha256": sha_bytes(p.stdout)})
+    return p
+
+
+def check(value, label):
+    if not value:
+        FAIL.append(label)
+    return value
+
+
+def manifest(path: Path):
+    out = []
+    for n, raw in enumerate(path.read_text().splitlines(), 1):
+        if not raw.strip():
+            continue
+        mo = re.fullmatch(r"([0-9a-fA-F]{64}) [ *](.+)", raw)
+        if not mo:
+            raise ValueError(f"bad manifest line {path}:{n}")
+        out.append((mo.group(1).lower(), mo.group(2)))
+    return out
+
+
+def verify_manifest(path: Path, root: Path):
+    rows = manifest(path)
+    missing, mismatch, ok = [], [], []
+    for expected, rel in rows:
+        p = root / rel
+        if not p.is_file():
+            missing.append(rel)
+        elif sha(p) != expected:
+            mismatch.append(rel)
+        else:
+            ok.append(rel)
+    return {"entries": len(rows), "ok": len(ok), "missing": len(missing),
+            "mismatch": len(mismatch), "missing_paths": missing,
+            "mismatch_paths": mismatch}
+
+
+def regular_files(root: Path):
+    return {p.relative_to(root).as_posix() for p in root.rglob("*") if p.is_file()}
+
+
+def cert_der(path: Path):
+    p = run(["openssl", "x509", "-in", path, "-outform", "DER"], cwd=HERE)
+    if p.returncode:
+        return None
+    return p.stdout
+
+
+def parse_test_count(text):
+    mo = re.search(r"Ran (\d+) tests?", text)
+    return int(mo.group(1)) if mo else None
+
+
+# Re-run the two exploratory commands so their outputs are independently hash logged.
+for _ in range(2):
+    run(["python3", "-c", "import os; print(os.getcwd())"], cwd=HERE)
+inspection_cmd = ["bash", "-c", "sed -n '1,240p' ../paths.json; sed -n '1,260p' ../automation/attempts.py; sed -n '1,320p' ../automation/state_machine.py; rg -n -C 8 'prepare-retry|finalize-current|show-attempts|SUBSTANTIVE_AUDIT_RESULT|MAX_ATTEMPTS|MAX_REPAIRS|material.manifest|material_manifest' ../automation/controller.py"]
+for _ in range(2):
+    run(inspection_cmd, cwd=HERE)
+third_cmd = ["bash", "-c", "sed -n '1,260p' ../build/candidate_plans_r7/L1-A31/RUN-A/plan.json; find ../lineage/R6_EXECUTION/evidence/L1-A31/RUN-A/stderr -type f -maxdepth 2 -print -exec sed -n '1,80p' {} \\;; sed -n '1,160p' ../references/manifest.json; sed -n '1,20p' ../build/R7_BUILD_MANIFEST.sha256; sed -n '1,20p' ../lineage/R6_EXECUTION_MANIFEST.sha256"]
+for _ in range(2):
+    run(third_cmd, cwd=HERE)
+
+# 1. Predecessor control manifests.
+item1 = {}
+for rev in ("R4", "R5", "R6"):
+    root = PROJECT / f"08.18.26_Level1_Audits_{rev}"
+    res = verify_manifest(root / "CONTROL_MANIFEST.sha256", root)
+    item1[rev] = res
+M["1_predecessors"] = item1
+check(item1["R4"]["missing"] == 0 and item1["R4"]["mismatch"] == 0, "1: R4 control manifest")
+check(item1["R5"]["missing"] == 0 and item1["R5"]["mismatch_paths"] == ["MODE"], "1: R5 sole MODE mismatch")
+check(item1["R6"]["missing"] == 0 and item1["R6"]["mismatch"] == 0, "1: R6 control manifest including MODE")
+
+# 2. Lineage manifest against both roots and complete file-set equality.
+lineage = R7 / "lineage/R6_EXECUTION"
+lm = R7 / "lineage/R6_EXECUTION_MANIFEST.sha256"
+lcopy = verify_manifest(lm, lineage)
+lorig = verify_manifest(lm, PROJECT / "08.18.26_Level1_Audits_R6")
+copy_files, orig_files = regular_files(lineage), regular_files(PROJECT / "08.18.26_Level1_Audits_R6")
+extra = sorted(copy_files - orig_files)
+missing_copy = sorted(orig_files - copy_files)
+M["2_lineage"] = {"manifest_entry_count": lcopy["entries"], "copy": lcopy,
+                    "original": lorig, "copy_extra_file_count": len(extra),
+                    "copy_missing_file_count": len(missing_copy),
+                    "copy_extra_files": extra, "copy_missing_files": missing_copy}
+check(lcopy["missing"] == lcopy["mismatch"] == lorig["missing"] == lorig["mismatch"] == 0, "2: lineage manifest verification")
+check(not extra and not missing_copy, "2: lineage and R6 file sets")
+
+# 3. Preserved failed attempt and exact stderr lines.
+ev = lineage / "evidence/L1-A31/RUN-A/EVIDENCE_MANIFEST.sha256"
+seal = lineage / "evidence/L1-A31/RUN-A/SEAL.json"
+stderr_root = lineage / "evidence/L1-A31/RUN-A/stderr"
+stderr_lines = []
+for p in sorted(stderr_root.glob("*")):
+    if p.is_file():
+        stderr_lines.extend(p.read_text(errors="replace").splitlines())
+need = {
+ "unsuitable_certificate_purpose": "error 26 at 0 depth lookup: unsuitable certificate purpose",
+ "certificate_not_yet_valid": "error 9 at 2 depth lookup: certificate is not yet valid",
+ "certificate_file_refusal": "Could not find certificate file from /home/ubuntu/project/WPNO/08.18.26_Level1_Audits_R6/work/L1-A31/preparation_2026-08-26/staged/controls/vhn_leaf_one_byte_mutated.pem",
+}
+M["3_failed_attempt"] = {"evidence_manifest_sha256": sha(ev), "seal_sha256": sha(seal),
+                           "exact_stderr_lines": need,
+                           "all_exact_lines_found": all(x in stderr_lines for x in need.values())}
+check(sha(ev) == "4a185eefb4f4221419a6cc7e53c2fe9b59c721c2def2bbb26864752013c1a85e", "3: evidence manifest digest")
+check(sha(seal) == "fcfeb8947fdb9c2bf01e6d0007a7adddbf4f5ec5138a78580e2dead622323edc", "3: seal digest")
+check(all(x in stderr_lines for x in need.values()), "3: stderr defect lines")
+
+# 4. Fresh state.
+progress_path = R7 / "state/progress.json"
+progress = json.loads(progress_path.read_text())
+phase_nodes = []
+for aid, phases in progress.get("audits", {}).items():
+    for phase, node in phases.items():
+        if isinstance(node, dict) and "state" in node:
+            phase_nodes.append((aid, phase, node))
+audits = {x[0] for x in phase_nodes}
+approvals_size = (R7 / "state/approvals.jsonl").stat().st_size
+transition_lines = (R7 / "state/transitions.jsonl").read_text().splitlines()
+transition = json.loads(transition_lines[0]) if len(transition_lines) == 1 else {}
+M["4_fresh_state"] = {"audit_count": len(audits), "phase_count": len(phase_nodes),
+ "not_started_count": sum(n.get("state") == "NOT_STARTED" for _,_,n in phase_nodes),
+ "verdict_key_count": sum("verdict" in n for _,_,n in phase_nodes),
+ "attempts_key_count": sum("attempts" in n for _,_,n in phase_nodes),
+ "approvals_bytes": approvals_size, "transition_line_count": len(transition_lines),
+ "initial_transition_route": transition.get("route"), "initial_transition_revision": transition.get("revision")}
+check(len(audits) == 35 and len(phase_nodes) == 43 and all(n.get("state") == "NOT_STARTED" and "verdict" not in n and "attempts" not in n for _,_,n in phase_nodes), "4: fresh progress")
+check(approvals_size == 0, "4: approvals empty")
+check(len(transition_lines) == 1 and transition.get("route") == "init-revision" and transition.get("revision") == "R7", "4: initial transition")
+
+# 5. Phase-attempt code model: import without bytecode and inspect executable definitions.
+sys.path.insert(0, str(R7))
+from automation import attempts, policy, state_machine  # noqa: E402
+attempt_src = (R7 / "automation/attempts.py").read_text()
+controller_src = (R7 / "automation/controller.py").read_text()
+terminal_no_exit = all(state_machine.TRANSITIONS[s] == () for s in state_machine.TERMINAL)
+state_sets_equal = set(state_machine.STATES) == set(state_machine.TRANSITIONS)
+refusal = "a substantive verdict is a statement about the target and cannot be retried or superseded"
+M["5_attempt_model"] = {
+ "substantive_verdicts": list(attempts.SUBSTANTIVE_VERDICTS),
+ "substantive_classification": {v: list(attempts.VERDICT_CLASSIFICATIONS[v]) for v in attempts.SUBSTANTIVE_VERDICTS},
+ "aggregate_internal_repairable": attempts.AGGREGATE_AFTER_SEAL["INTERNAL_REPAIRABLE_DEFECT"],
+ "internal_retry_state_terminal": state_machine.is_terminal("RETRYABLE_INTERNAL_ERROR"),
+ "aggregate_missing_external": attempts.AGGREGATE_AFTER_SEAL["MISSING_EXTERNAL_REFERENCE_OR_OPERATOR_INPUT"],
+ "external_material_required": "MISSING_EXTERNAL_REFERENCE_OR_OPERATOR_INPUT" in attempts.REQUIRES_EXTERNAL_MATERIAL,
+ "prepare_retry_reports_approval_recorded_false": '"approval_recorded": False' in controller_src,
+ "prepare_retry_reports_operations_executed_zero": '"operations_executed": 0' in controller_src,
+ "max_attempts_per_phase": policy.MAX_ATTEMPTS_PER_PHASE,
+ "max_repairs_per_root_cause": policy.MAX_REPAIRS_PER_ROOT_CAUSE,
+ "attempt_limit_enforcement_found": "exceeds MAX_ATTEMPTS_PER_PHASE" in attempt_src,
+ "repair_limit_enforcement_found": "MAX_REPAIRS_PER_ROOT_CAUSE=%d has been reached" in attempt_src,
+ "terminal_states_no_exit": terminal_no_exit, "states_equal_transition_keys": state_sets_equal,
+ "substantive_retry_refusal_exact": refusal,
+ "substantive_retry_refusal_found": refusal in attempt_src,
+ "sealed_record_overwrite_refusal_found": "a sealed attempt record is immutable and cannot be rewritten" in attempt_src,
+ "external_manifest_gate_found": "material manifest is required before retry" in attempt_src,
+}
+check(all(attempts.VERDICT_CLASSIFICATIONS[v] == ("SUBSTANTIVE_AUDIT_RESULT",) for v in attempts.SUBSTANTIVE_VERDICTS), "5: substantive classification")
+check(attempts.AGGREGATE_AFTER_SEAL["INTERNAL_REPAIRABLE_DEFECT"] == "RETRYABLE_INTERNAL_ERROR" and not state_machine.is_terminal("RETRYABLE_INTERNAL_ERROR"), "5: internal retry state")
+check(attempts.AGGREGATE_AFTER_SEAL["MISSING_EXTERNAL_REFERENCE_OR_OPERATOR_INPUT"] == "BLOCKED_FOR_EXTERNAL_MATERIAL" and "MISSING_EXTERNAL_REFERENCE_OR_OPERATOR_INPUT" in attempts.REQUIRES_EXTERNAL_MATERIAL, "5: external material state")
+check('"approval_recorded": False' in controller_src and '"operations_executed": 0' in controller_src, "5: prepare-retry no approval/execution")
+check(policy.MAX_ATTEMPTS_PER_PHASE == 3 and policy.MAX_REPAIRS_PER_ROOT_CAUSE == 2 and M["5_attempt_model"]["attempt_limit_enforcement_found"] and M["5_attempt_model"]["repair_limit_enforcement_found"], "5: limits and enforcement")
+check(terminal_no_exit and state_sets_equal, "5: transition totality and terminal exits")
+check(refusal in attempt_src and M["5_attempt_model"]["sealed_record_overwrite_refusal_found"] and M["5_attempt_model"]["external_manifest_gate_found"], "5: explicit immutability/refusal/material gates")
+
+# 6. Corrected plan.
+plan_path = R7 / "build/candidate_plans_r7/L1-A31/RUN-A/plan.json"
+plan = json.loads(plan_path.read_text())
+steps = plan["steps"]
+matrix = {x.get("step_id"): x for x in plan.get("test_matrix", []) if x.get("step_id")}
+real_crypto = [s for s in steps if s["step_id"] in ("vhn_chain_path_validation", "document_chain_path_validation", "vhn_cms", "document_cms")]
+ku = matrix.get("vhn_key_usage_conformance", {})
+negmut = [s for s in steps if s.get("control_role") in ("NEGATIVE", "MUTATION")]
+reason_missing = [s["step_id"] for s in negmut if not matrix.get(s["step_id"], {}).get("expected_failure_reason")]
+syn = next(s for s in steps if s["step_id"] == "synthetic_chain_positive")
+attime = syn["params"]["attime"]
+dates = {}
+inside = True
+for key in ("anchor", "intermediates", "leaf"):
+    cp = Path(syn["params"][key])
+    pr = run(["openssl", "x509", "-in", cp, "-noout", "-dates"], cwd=HERE)
+    txt = pr.stdout.decode(errors="replace")
+    vals = dict(line.split("=", 1) for line in txt.splitlines() if "=" in line)
+    nb = int(dt.datetime.strptime(vals["notBefore"], "%b %d %H:%M:%S %Y %Z").replace(tzinfo=dt.timezone.utc).timestamp())
+    na = int(dt.datetime.strptime(vals["notAfter"], "%b %d %H:%M:%S %Y %Z").replace(tzinfo=dt.timezone.utc).timestamp())
+    dates[key] = {"path": str(cp), "not_before_epoch": nb, "not_after_epoch": na, "attime_inside": nb <= attime <= na}
+    inside = inside and nb <= attime <= na
+mut_step = next(s for s in steps if s["step_id"] == "mutated_vhn_leaf_signature")
+bad_step = next(s for s in steps if s["step_id"] == "unparseable_vhn_leaf")
+mut_path, bad_path = Path(mut_step["params"]["leaf"]), Path(bad_step["params"]["leaf"])
+mut_parse = run(["openssl", "x509", "-in", mut_path, "-noout", "-subject"], cwd=HERE)
+bad_parse = run(["openssl", "x509", "-in", bad_path, "-noout", "-subject"], cwd=HERE)
+suppression_tokens = ["-noverify", "-no-verify", "-no_check_time", "-no-check-time", "-nosigs", "-noverifyretcode"]
+plan_lower = plan_path.read_text().lower()
+suppression_found = [x for x in suppression_tokens if x in plan_lower]
+M["6_l1_a31_plan"] = {
+ "real_chain_cms_purposes": {s["step_id"]: s["params"].get("purpose") for s in real_crypto},
+ "vhn_key_usage_conformance": ku, "synthetic_attime_epoch": attime,
+ "synthetic_certificate_dates": dates, "attime_inside_all": inside,
+ "negative_mutation_step_count": len(negmut), "missing_expected_failure_reason": reason_missing,
+ "mutation_fixture": str(mut_path), "mutation_parse_exit_code": mut_parse.returncode,
+ "parse_refusal_fixture": str(bad_path), "parse_refusal_exit_code": bad_parse.returncode,
+ "fixtures_are_different": mut_path != bad_path, "suppression_flags_found": suppression_found}
+check(len(real_crypto) == 4 and all(s["params"].get("purpose") == "any" for s in real_crypto), "6: real chain/CMS purpose any")
+check(bool(ku.get("criteria")) and "expected_result" in ku, "6: key usage criteria and expected result")
+check(inside, "6: synthetic attime validity")
+check(not reason_missing, "6: negative/mutation failure reasons")
+check(mut_path != bad_path and mut_parse.returncode == 0 and bad_parse.returncode != 0, "6: distinct mutation and parse-refusal fixtures")
+check(not suppression_found, "6: no suppression flag")
+
+# 7. Rehearsal with state hash before and after.
+before = sha(progress_path)
+reh = run(["python3", "build/rehearse_candidate_plans.py"], cwd=R7, timeout=1200)
+after = sha(progress_path)
+reh_text = (reh.stdout + reh.stderr).decode(errors="replace")
+pass_ready = len(re.findall(r"\bPASS_READY\b", reh_text))
+M["7_rehearsal"] = {"exit_code": reh.returncode, "pass_ready_count": pass_ready,
+ "progress_sha256_before": before, "progress_sha256_after": after, "progress_unchanged": before == after,
+ "stdout_sha256": sha_bytes(reh.stdout), "stderr_sha256": sha_bytes(reh.stderr)}
+check(reh.returncode == 0 and pass_ready == 9 and before == after, "7: rehearsal and unchanged state")
+
+# 8. Tests.
+tests = {}
+for name, argv, cwd in (
+ ("selftest_runtime", ["python3", "-m", "unittest", "discover"], R7 / "verification/selftest_runtime"),
+ ("package_tests", ["python3", "-m", "unittest", "discover", "-s", "automation/package_tests", "-t", "."], R7)):
+    p = run(argv, cwd=cwd, timeout=1200)
+    txt = (p.stdout + p.stderr).decode(errors="replace")
+    tests[name] = {"exit_code": p.returncode, "tests_run": parse_test_count(txt),
+                   "failures": int((re.search(r"failures=(\d+)", txt) or [None, 0])[1]),
+                   "errors": int((re.search(r"errors=(\d+)", txt) or [None, 0])[1]),
+                   "skips": int((re.search(r"skipped=(\d+)", txt) or [None, 0])[1]),
+                   "stdout_sha256": sha_bytes(p.stdout), "stderr_sha256": sha_bytes(p.stderr)}
+M["8_tests"] = tests
+for name, x in tests.items():
+    check(x["exit_code"] == 0 and x["tests_run"] is not None and x["failures"] == x["errors"] == x["skips"] == 0, f"8: {name}")
+
+# 9. Packaged static review plus independent AST/text checks.
+sr = run(["python3", "build/r7_static_safety_review.py"], cwd=R7, timeout=1200)
+sr_text = (sr.stdout + sr.stderr).decode(errors="replace")
+py_files = []
+for base in (R7 / "automation", R7 / "build", R7 / "tools"):
+    py_files += list(base.rglob("*.py"))
+py_files += list(R7.glob("*.py"))
+findings = []
+network_roots = {"socket", "urllib", "http", "requests", "aiohttp", "ftplib", "smtplib", "telnetlib"}
+for p in sorted(set(py_files)):
+    rel = p.relative_to(R7).as_posix()
+    try:
+        tree = ast.parse(p.read_text(), filename=rel)
+    except (SyntaxError, UnicodeDecodeError) as e:
+        findings.append({"path": rel, "kind": "parse", "detail": str(e)})
+        continue
+    for node in ast.walk(tree):
+        if isinstance(node, (ast.Import, ast.ImportFrom)):
+            names = [a.name for a in node.names] if isinstance(node, ast.Import) else [node.module or ""]
+            for nm in names:
+                if nm.split(".")[0] in network_roots:
+                    findings.append({"path": rel, "line": node.lineno, "kind": "network_import", "detail": nm})
+        if isinstance(node, ast.Call):
+            fn = node.func
+            dotted = None
+            if isinstance(fn, ast.Name): dotted = fn.id
+            elif isinstance(fn, ast.Attribute) and isinstance(fn.value, ast.Name): dotted = fn.value.id + "." + fn.attr
+            if dotted in {"eval", "exec", "os.system", "runpy.run_module", "importlib.import_module"}:
+                findings.append({"path": rel, "line": node.lineno, "kind": "banned_call", "detail": dotted})
+            if dotted == "subprocess.run":
+                kw = {k.arg: k.value for k in node.keywords if k.arg}
+                if not (isinstance(kw.get("shell"), ast.Constant) and kw["shell"].value is False):
+                    findings.append({"path": rel, "line": node.lineno, "kind": "subprocess_run", "detail": "shell is not literal False"})
+                for req in ("timeout", "env", "cwd"):
+                    if req not in kw:
+                        findings.append({"path": rel, "line": node.lineno, "kind": "subprocess_run", "detail": f"missing {req}"})
+write_r456 = []
+for p in sorted(set(py_files)):
+    textp = p.read_text(errors="replace")
+    for n, line in enumerate(textp.splitlines(), 1):
+        if re.search(r"Level1_Audits_R[456]", line) and re.search(r"write|open|replace|rename|unlink|remove|mkdir|chmod", line, re.I):
+            write_r456.append({"path": p.relative_to(R7).as_posix(), "line": n, "text": line.strip()})
+M["9_static_safety"] = {"script_exit_code": sr.returncode, "script_clean_true": "clean: True" in sr_text,
+ "script_zero_findings": bool(re.search(r"findings:\s*0\b", sr_text)),
+ "script_no_unpermitted_changes": "unpermitted_changes: 0" in sr_text,
+ "independent_findings_count": len(findings), "independent_findings": findings,
+ "r4_r5_r6_write_reference_count": len(write_r456), "r4_r5_r6_write_references": write_r456,
+ "stdout_sha256": sha_bytes(sr.stdout), "stderr_sha256": sha_bytes(sr.stderr)}
+check(sr.returncode == 0 and M["9_static_safety"]["script_clean_true"] and M["9_static_safety"]["script_zero_findings"] and M["9_static_safety"]["script_no_unpermitted_changes"], "9: packaged static review")
+check(not findings, "9: independent forbidden constructs/subprocess requirements")
+check(not write_r456, "9: no writes into R4/R5/R6")
+
+# 10. References and input certificate identity.
+ref_manifest = json.loads((R7 / "references/manifest.json").read_text())
+ref_rows = ref_manifest["references"]
+ref_bad, ref_missing = [], []
+for row in ref_rows:
+    p = R7 / row["file"]
+    if not p.is_file(): ref_missing.append(row["file"])
+    elif sha(p) != row["sha256"]: ref_bad.append(row["file"])
+cert_dir = R7 / "work/L1-A31/preparation_r7_2026-08-26/certs"
+ca_names = ["vhn_intermediate_selected_manual_pem.pem", "vhn_root.pem", "document_intermediate.pem", "document_root.pem"]
+ref_cert_files = [p for p in (R7 / "references").rglob("*") if p.is_file()]
+intake_root = R7 / "work/operator_intake/L1-A31/official_chain_material_r7_2026-08-26"
+intake_files = [p for p in intake_root.rglob("*") if p.is_file()]
+cert_matches = {}
+for name in ca_names:
+    staged = cert_dir / name
+    der = cert_der(staged)
+    dh = sha_bytes(der) if der is not None else None
+    refs, intakes = [], []
+    if der is not None:
+        for p in ref_cert_files:
+            q = cert_der(p)
+            if q == der: refs.append(p.relative_to(R7).as_posix())
+        for p in intake_files:
+            q = cert_der(p)
+            if q == der: intakes.append(p.relative_to(R7).as_posix())
+    cert_matches[name] = {"der_sha256": dh, "reference_matches": refs, "operator_intake_matches": intakes}
+sha2_path = R7 / "references/REF-08-TL-DE.sha2"
+xml_path = R7 / "references/REF-08-TL-DE.xml"
+sha2_text = sha2_path.read_text(errors="replace")
