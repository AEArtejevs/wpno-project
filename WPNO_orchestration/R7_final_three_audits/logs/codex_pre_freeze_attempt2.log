#!/usr/bin/env python3
"""Independent, offline R7 pre-freeze verifier. Writes only beside this file."""
from __future__ import annotations

import ast
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys

HERE = Path(__file__).resolve().parent
R7 = HERE.parent
PROJECT = R7.parent
ENV = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
LOG = []
FAIL = []
M = {}


def sha_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for block in iter(lambda: f.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


def run(argv, cwd=R7, timeout=600):
    argv = [str(x) for x in argv]
    p = subprocess.run(argv, cwd=str(cwd), env=ENV, shell=False,
                       timeout=timeout, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE)
    LOG.append({"argv": argv, "exit_code": p.returncode,
                "stdout_sha256": sha_bytes(p.stdout)})
    return p


def check(value, label):
    if not value:
        FAIL.append(label)
    return value


def manifest(path: Path):
    out = []
    for n, raw in enumerate(path.read_text().splitlines(), 1):
        if not raw.strip():
            continue
        mo = re.fullmatch(r"([0-9a-fA-F]{64}) [ *](.+)", raw)
        if not mo:
            raise ValueError(f"bad manifest line {path}:{n}")
        out.append((mo.group(1).lower(), mo.group(2)))
    return out


def verify_manifest(path: Path, root: Path):
    rows = manifest(path)
    missing, mismatch, ok = [], [], []
    for expected, rel in rows:
        p = root / rel
        if not p.is_file():
            missing.append(rel)
        elif sha(p) != expected:
            mismatch.append(rel)
        else:
            ok.append(rel)
    return {"entries": len(rows), "ok": len(ok), "missing": len(missing),
            "mismatch": len(mismatch), "missing_paths": missing,
            "mismatch_paths": mismatch}


def regular_files(root: Path):
    return {p.relative_to(root).as_posix() for p in root.rglob("*") if p.is_file()}


def cert_der(path: Path):
    p = run(["openssl", "x509", "-in", path, "-outform", "DER"], cwd=HERE)
    if p.returncode:
        return None
    return p.stdout


def parse_test_count(text):
    mo = re.search(r"Ran (\d+) tests?", text)
    return int(mo.group(1)) if mo else None


# Re-run the two exploratory commands so their outputs are independently hash logged.
for _ in range(2):
    run(["python3", "-c", "import os; print(os.getcwd())"], cwd=HERE)
inspection_cmd = ["bash", "-c", "sed -n '1,240p' ../paths.json; sed -n '1,260p' ../automation/attempts.py; sed -n '1,320p' ../automation/state_machine.py; rg -n -C 8 'prepare-retry|finalize-current|show-attempts|SUBSTANTIVE_AUDIT_RESULT|MAX_ATTEMPTS|MAX_REPAIRS|material.manifest|material_manifest' ../automation/controller.py"]
for _ in range(2):
    run(inspection_cmd, cwd=HERE)
third_cmd = ["bash", "-c", "sed -n '1,260p' ../build/candidate_plans_r7/L1-A31/RUN-A/plan.json; find ../lineage/R6_EXECUTION/evidence/L1-A31/RUN-A/stderr -type f -maxdepth 2 -print -exec sed -n '1,80p' {} \\;; sed -n '1,160p' ../references/manifest.json; sed -n '1,20p' ../build/R7_BUILD_MANIFEST.sha256; sed -n '1,20p' ../lineage/R6_EXECUTION_MANIFEST.sha256"]
for _ in range(2):
    run(third_cmd, cwd=HERE)

# 1. Predecessor control manifests.
item1 = {}
for rev in ("R4", "R5", "R6"):
    root = PROJECT / f"08.18.26_Level1_Audits_{rev}"
    res = verify_manifest(root / "CONTROL_MANIFEST.sha256", root)
    item1[rev] = res
M["1_predecessors"] = item1
check(item1["R4"]["missing"] == 0 and item1["R4"]["mismatch"] == 0, "1: R4 control manifest")
check(item1["R5"]["missing"] == 0 and item1["R5"]["mismatch_paths"] == ["MODE"], "1: R5 sole MODE mismatch")
check(item1["R6"]["missing"] == 0 and item1["R6"]["mismatch"] == 0, "1: R6 control manifest including MODE")

# 2. Lineage manifest against both roots and complete file-set equality.
lineage = R7 / "lineage/R6_EXECUTION"
lm = R7 / "lineage/R6_EXECUTION_MANIFEST.sha256"
lcopy = verify_manifest(lm, lineage)
lorig = verify_manifest(lm, PROJECT / "08.18.26_Level1_Audits_R6")
copy_files, orig_files = regular_files(lineage), regular_files(PROJECT / "08.18.26_Level1_Audits_R6")
extra = sorted(copy_files - orig_files)
missing_copy = sorted(orig_files - copy_files)
M["2_lineage"] = {"manifest_entry_count": lcopy["entries"], "copy": lcopy,
                    "original": lorig, "copy_extra_file_count": len(extra),
                    "copy_missing_file_count": len(missing_copy),
                    "copy_extra_files": extra, "copy_missing_files": missing_copy}
check(lcopy["missing"] == lcopy["mismatch"] == lorig["missing"] == lorig["mismatch"] == 0, "2: lineage manifest verification")
check(not extra and not missing_copy, "2: lineage and R6 file sets")

# 3. Preserved failed attempt and exact stderr lines.
ev = lineage / "evidence/L1-A31/RUN-A/EVIDENCE_MANIFEST.sha256"
seal = lineage / "evidence/L1-A31/RUN-A/SEAL.json"
stderr_root = lineage / "evidence/L1-A31/RUN-A/stderr"
stderr_lines = []
for p in sorted(stderr_root.glob("*")):
    if p.is_file():
        stderr_lines.extend(p.read_text(errors="replace").splitlines())
need = {
 "unsuitable_certificate_purpose": "error 26 at 0 depth lookup: unsuitable certificate purpose",
 "certificate_not_yet_valid": "error 9 at 2 depth lookup: certificate is not yet valid",
 "certificate_file_refusal": "Could not find certificate file from /home/ubuntu/project/WPNO/08.18.26_Level1_Audits_R6/work/L1-A31/preparation_2026-08-26/staged/controls/vhn_leaf_one_byte_mutated.pem",
}
M["3_failed_attempt"] = {"evidence_manifest_sha256": sha(ev), "seal_sha256": sha(seal),
                           "exact_stderr_lines": need,
                           "all_exact_lines_found": all(x in stderr_lines for x in need.values())}
check(sha(ev) == "4a185eefb4f4221419a6cc7e53c2fe9b59c721c2def2bbb26864752013c1a85e", "3: evidence manifest digest")
check(sha(seal) == "fcfeb8947fdb9c2bf01e6d0007a7adddbf4f5ec5138a78580e2dead622323edc", "3: seal digest")
check(all(x in stderr_lines for x in need.values()), "3: stderr defect lines")

# 4. Fresh state.
progress_path = R7 / "state/progress.json"
progress = json.loads(progress_path.read_text())
phase_nodes = []
for aid, phases in progress.get("audits", {}).items():
    for phase, node in phases.items():
        if isinstance(node, dict) and "state" in node:
            phase_nodes.append((aid, phase, node))
audits = {x[0] for x in phase_nodes}
approvals_size = (R7 / "state/approvals.jsonl").stat().st_size
transition_lines = (R7 / "state/transitions.jsonl").read_text().splitlines()
transition = json.loads(transition_lines[0]) if len(transition_lines) == 1 else {}
M["4_fresh_state"] = {"audit_count": len(audits), "phase_count": len(phase_nodes),
 "not_started_count": sum(n.get("state") == "NOT_STARTED" for _,_,n in phase_nodes),
 "verdict_key_count": sum("verdict" in n for _,_,n in phase_nodes),
 "attempts_key_count": sum("attempts" in n for _,_,n in phase_nodes),
