result_seals = list((R7 / "results").rglob("SEAL.json")) if (R7 / "results").exists() else []
evidence_seals = list((R7 / "evidence").rglob("SEAL.json")) if (R7 / "evidence").exists() else []
result_plans = list((R7 / "results").rglob("plan.json")) if (R7 / "results").exists() else []
evidence_plans = list((R7 / "evidence").rglob("plan.json")) if (R7 / "evidence").exists() else []
