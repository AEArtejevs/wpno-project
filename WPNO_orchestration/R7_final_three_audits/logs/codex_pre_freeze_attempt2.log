  "note": "Every value is resolved against the directory that contains this file. A relative value keeps the package free of a hardcoded user name and lets an isolated self-test replica declare its own roots without editing code. An absolute value beginning with '/' is also accepted and is used verbatim.",
  "project_root": "..",
  "discovery_root": "../08.18.26_Discovery",
  "level1_root": "."
}

exec
/bin/bash -lc "sed -n '261,620p' verification_codex_pre_freeze/verify_r7.py" in /home/ubuntu/project/WPNO/08.18.26_Level1_Audits_R7
 succeeded in 0ms:
 "progress_sha256_before": before, "progress_sha256_after": after, "progress_unchanged": before == after,
 "stdout_sha256": sha_bytes(reh.stdout), "stderr_sha256": sha_bytes(reh.stderr)}
check(reh.returncode == 0 and pass_ready == 9 and before == after, "7: rehearsal and unchanged state")

# 8. Tests.
