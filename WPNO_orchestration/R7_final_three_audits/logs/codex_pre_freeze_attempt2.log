findings = []
network_roots = {"socket", "urllib", "http", "requests", "aiohttp", "ftplib", "smtplib", "telnetlib"}
for p in sorted(set(py_files)):
    rel = p.relative_to(R7).as_posix()
    try:
        tree = ast.parse(p.read_text(), filename=rel)
    except (SyntaxError, UnicodeDecodeError) as e:
        findings.append({"path": rel, "kind": "parse", "detail": str(e)})
        continue
    for node in ast.walk(tree):
        if isinstance(node, (ast.Import, ast.ImportFrom)):
            names = [a.name for a in node.names] if isinstance(node, ast.Import) else [node.module or ""]
            for nm in names:
                if nm.split(".")[0] in network_roots:
                    findings.append({"path": rel, "line": node.lineno, "kind": "network_import", "detail": nm})
        if isinstance(node, ast.Call):
            fn = node.func
            dotted = None
            if isinstance(fn, ast.Name): dotted = fn.id
            elif isinstance(fn, ast.Attribute) and isinstance(fn.value, ast.Name): dotted = fn.value.id + "." + fn.attr
            if dotted in {"eval", "exec", "os.system", "runpy.run_module", "importlib.import_module"}:
                findings.append({"path": rel, "line": node.lineno, "kind": "banned_call", "detail": dotted})
            if dotted == "subprocess.run":
                kw = {k.arg: k.value for k in node.keywords if k.arg}
                if not (isinstance(kw.get("shell"), ast.Constant) and kw["shell"].value is False):
                    findings.append({"path": rel, "line": node.lineno, "kind": "subprocess_run", "detail": "shell is not literal False"})
                for req in ("timeout", "env", "cwd"):
                    if req not in kw:
