#!/usr/bin/env python3
"""Build the final pre-freeze closure record.

Everything in it is measured here, from disk, at the moment it is written.
Nothing is copied forward from an earlier record and nothing is asserted that
was not read: a closure record whose numbers came from another document would
be a summary of that document rather than of the package.

It is written before the final build manifest so the manifest can cover it.
The manifest cannot cover anything written afterwards, which is why the two
directories created later - the fresh verifier's output and the freeze plan -
are excluded from the manifest by a named rule and bound by the freeze plan
instead.
"""

import json
import os
import subprocess
import sys
import time

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

from automation import hashing, path_policy, state_machine  # noqa: E402

