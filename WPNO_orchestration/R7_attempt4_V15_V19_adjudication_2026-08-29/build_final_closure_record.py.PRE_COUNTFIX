    predecessors = {}
    for name, root in sorted(PREDECESSORS.items()):
        digest, files = snapshot(root)
        predecessors[name] = {
            "root": root, "files": files,
            "measured_snapshot_sha256": digest,
            "recorded_snapshot_sha256": RECORDED_PREDECESSOR_DIGESTS[name],
            "unchanged": digest == RECORDED_PREDECESSOR_DIGESTS[name],
        }

