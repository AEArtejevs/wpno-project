            "attempt_1": {
                "path": "verification_codex_final_pre_freeze_attempt_1/",
                "result": "VERIFICATION_FAIL_PRE_FREEZE_R7_FINAL",
                "items_passed": 17,
                "items_failed": ["V1", "V13", "V16"],
                "disposition": ("preserved unchanged. One finding was a real "
                                "defect in the package and is repaired "
                                "(FPF-007); two were artefacts of the "
                                "verifier's own harness and are recorded as "
                                "such with the measurement that settles each."),
            },
            "attempt_2": {
                "path": "verification_codex_final_pre_freeze_attempt_2/",
                "result": "VERIFICATION_FAIL_PRE_FREEZE_R7_FINAL",
                "items_passed": 15,
                "items_failed": ["V13", "V15", "V17", "V19", "V20"],
                "disposition": ("preserved unchanged. V1 and V16 passed once "
                                "the brief named the method instead of a "
                                "phrase. Three findings were real and are "
                                "repaired (FPF-008, FPF-009, FPF-010); two "
                                "were artefacts and are recorded with the "
                                "measurement that settles each."),
            },
        },
        "what_the_two_attempts_cost_and_bought": (
            "Five real defects surfaced across the two attempts that the build "
            "session did not find on its own: a plan denying a path by naming "
            "it, static-safety evidence that had gone stale under an editing "
            "order of my own making, a correction record that re-created the "
            "dangling path it documented, and an untested refusal in the "
            "freeze mechanism. Four verifier findings were harness artefacts, "
            "and each is recorded with the measurement that disposes of it "
            "rather than dismissed."),
        "predecessor_integrity_record": "lineage/PREDECESSOR_INTEGRITY.json",
        "live_state": live_state(),
        "predecessors": predecessors,
        "lineage_record": os.path.relpath(LINEAGE, ROOT),
        "lineage_record_sha256": hashing.sha256_file(LINEAGE),

        "no_live_phase_started": True,
        "no_live_approval_recorded": True,
        "no_freeze_token_generated_recorded_or_consumed": True,
        "external_host_route": {
            "audit": "L1-A24",
            "classification": "C_EXISTING_EXTERNAL_EVIDENCE_INTAKE_ROUTE_"
                              "COMPLETED_BY_A_GENERIC_MECHANISM",
            "what_existed": (
                "CLAUDE_LOAD_BEHAVIOUR_TEST was already catalogued as GATED "
                "and documented as operator-performed with its transcript "
                "imported as evidence."),
            "what_was_missing": (
                "no execution route. The operation was not in IN_PROCESS, so "
                "the controller would have called build_argv and raised. A "
                "plan step using it would have failed at execution rather "
                "than being recorded as performed elsewhere."),
            "what_was_added": (
                "automation/external_host_evidence.py - packet construction, "
                "hash-bound intake admission and the refusals; and "
                "OPERATOR_PERFORMED in the catalogue, handled by the "
                "controller. Nothing in the module names L1-A24, and a test "
                "asserts that."),
            "the_mac_directory": (
                "/Users/martinotten/Downloads is the operator-approved "
                "external working directory. It does not exist on this Ubuntu "
                "host, is not claimed to, and no local directory is "
                "substituted for it. No Mac launch has occurred."),
        },
    }

    text = json.dumps(record, indent=2, sort_keys=True) + "\n"
    with open(path_policy.assert_writable(OUT), "w", encoding="utf-8") as fh:
        fh.write(text)
    print(json.dumps({
        "closure_record": os.path.relpath(OUT, ROOT),
        "closure_record_sha256": hashing.sha256_text(text),
        "AUDITS_READY_FOR_PLANNING": record["readiness"]["AUDITS_READY_FOR_PLANNING"],
        "CANDIDATE_PLAN_COUNT": record["plan_coverage"]["CANDIDATE_PLAN_COUNT"],
        "PASS_READY_COUNT": record["rehearsal"]["PASS_READY_COUNT"],
        "STATIC_SAFETY_FINDINGS": record["static_safety"]["STATIC_SAFETY_FINDINGS"],
        "predecessors_unchanged": {k: v["unchanged"]
                                   for k, v in predecessors.items()},
        "live_phase_states": record["live_state"]["states"],
    }, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
