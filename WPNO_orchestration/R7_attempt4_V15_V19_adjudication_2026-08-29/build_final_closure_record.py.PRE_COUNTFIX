def load(path):
    with open(path, encoding="utf-8") as fh:
        return json.load(fh)


def snapshot(root):
    """The deterministic whole-tree snapshot lineage records as its method."""
    import hashlib
    entries = {}
    root = os.path.realpath(root)
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        dirnames.sort()
        for name in sorted(filenames):
            full = os.path.join(dirpath, name)
            if os.path.islink(full):
                continue
            entries[os.path.relpath(full, root)] = hashing.sha256_file(full)
    text = "\n".join("%s  %s" % (entries[k], k) for k in sorted(entries)) + "\n"
    return hashlib.sha256(text.encode("utf-8")).hexdigest(), len(entries)


def live_state():
    progress = load(os.path.join(ROOT, "state", "progress.json"))
    states, records = {}, 0
    verdicts = results = approvals = 0
    for audit in progress["audits"].values():
        for phase in audit.values():
            records += 1
            states[phase["state"]] = states.get(phase["state"], 0) + 1
            verdicts += 1 if "verdict" in phase else 0
            results += 1 if "result" in phase else 0
            approvals += 1 if "approval" in phase else 0
    approvals_path = os.path.join(ROOT, "state", "approvals.jsonl")
    return {
        "phase_records": records,
        "states": states,
        "verdict_fields_present": verdicts,
        "result_fields_present": results,
        "approval_fields_present": approvals,
        "approvals_jsonl_bytes": os.path.getsize(approvals_path),
        "transitions": sum(1 for line in open(
            os.path.join(ROOT, "state", "transitions.jsonl"),
            encoding="utf-8") if line.strip()),
        "results_files": sum(len(f) for _, _, f in
                             os.walk(os.path.join(ROOT, "results"))),
        "evidence_files": sum(len(f) for _, _, f in
                              os.walk(os.path.join(ROOT, "evidence"))),
        "logs_files": sum(len(f) for _, _, f in
                          os.walk(os.path.join(ROOT, "logs"))),
        "freeze_artefacts_present": [
            rel for rel in ("CONTROL_MANIFEST.sha256", "BASELINE_MANIFEST.json",
                            os.path.join("state", "PACKAGE_VERIFIED.json"),
                            os.path.join("state", "freeze_attempts.jsonl"))
            if os.path.exists(os.path.join(ROOT, rel))],
    }


